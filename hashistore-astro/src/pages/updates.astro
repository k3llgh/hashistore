---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Updates | hashistore">
  <section class="page-hero simple-hero">
    <div class="container narrow">
      <span class="eyebrow">HashiStore updates</span>
      <h1>News, stock notes & store updates.</h1>
      <p>This page is ready for new announcements as the business grows.</p>
    </div>
  </section>

  <section class="section">
    <div class="container updates-list">
      <article class="update-card">
        <span class="update-date">2026 · Store launch</span>
        <h2>Welcome to hashistore.</h2>
        <p>Our new online catalogue makes it easier to discover school and office supplies from Hashirama Traders Ltd. For stock and order enquiries, contact us directly.</p>
      </article>
      <article class="update-card">
        <span class="update-date">Coming soon</span>
        <h2>More products, same simple process.</h2>
        <p>New stationery categories and product highlights can be added here without changing the core store experience.</p>
      </article>
    </div>
  </section>
</Layout>
