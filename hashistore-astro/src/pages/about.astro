---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About | hashistore">
  <section class="page-hero simple-hero">
    <div class="container narrow">
      <span class="eyebrow">About HashiStore</span>
      <h1>Stationery that keeps everyday work moving.</h1>
      <p>HashiStore is the retail-facing name for Hashirama Traders Ltd, serving customers looking for school, office and general stationery supplies.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split about-grid">
      <div>
        <span class="eyebrow">What we do</span>
        <h2>Wholesale and retail, without the complicated process.</h2>
      </div>
      <div class="prose">
        <p>Whether you are stocking a classroom, setting up an office or buying a few essentials, Hashirama Traders Ltd is built around straightforward product enquiries and practical supply.</p>
        <p>Because this website is a static catalogue, prices and inventory are confirmed directly. Send a WhatsApp enquiry for current availability, quantities and order details.</p>
      </div>
    </div>
  </section>

  <section class="section values-section">
    <div class="container">
      <div class="three-grid">
        <article><span>01</span><h3>Practical</h3><p>A focused range of supplies people actually use.</p></article>
        <article><span>02</span><h3>Flexible</h3><p>Retail purchases and larger school or office requirements.</p></article>
        <article><span>03</span><h3>Direct</h3><p>Simple enquiries through WhatsApp or email.</p></article>
      </div>
    </div>
  </section>
</Layout>
