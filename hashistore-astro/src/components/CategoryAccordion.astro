---
import ProductTile from './ProductTile.astro';
const { category, enquiryFor } = Astro.props;
---
<details class="cat" id={category.id} data-groups={category.groups.join(' ')}>
  <summary class="cat-summary">
    <div class="cat-thumb">
      {category.image
        ? <img src={category.image} alt="" loading="lazy" />
        : <div class="placeholder" aria-hidden="true">Image coming soon</div>}
    </div>
    <div class="cat-info">
      <span class="eyebrow">{category.products.length} products</span>
      <h3>{category.name}</h3>
      <p>{category.description}</p>
    </div>
    <span class="cat-chevron" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
    </span>
  </summary>
  <div class="cat-body">
    <div class="product-tiles">
      {category.products.map((product) => (
        <ProductTile product={product} categoryName={category.name} enquiryHref={enquiryFor(product.name, category.name)} />
      ))}
    </div>
  </div>
</details>
