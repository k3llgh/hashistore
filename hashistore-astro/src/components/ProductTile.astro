---
const { product, categoryName, enquiryHref } = Astro.props;
const external = enquiryHref.startsWith('https://');
---
<article class="product-tile">
  <div class="product-media">
    {product.image
      ? <img src={product.image} alt={product.name} loading="lazy" />
      : <div class="placeholder" role="img" aria-label="Product image coming soon">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m21 16-5-5-8 8"></path>
          </svg>
          <span>Image coming soon</span>
        </div>}
  </div>
  <div class="product-tile-body">
    <span class="eyebrow">{categoryName}</span>
    <h4>{product.name}</h4>
    <p>{product.description}</p>
    <a class="text-link" href={enquiryHref} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>Ask about stock →</a>
  </div>
</article>
